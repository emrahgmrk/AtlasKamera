<Window x:Class="AtlasKamera.Pencereler.KameraYonetimi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kameralar" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#0F131B">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA4B2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="BorderBrush" Value="#263041"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CaretBrush" Value="#E6EAF2"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="BorderBrush" Value="#263041"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CaretBrush" Value="#E6EAF2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B26"/>
            <Setter Property="Foreground" Value="#0B0E14"/>
            <Setter Property="BorderBrush" Value="#263041"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D0DC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Dugme" TargetType="Button">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="k" CornerRadius="5" Background="#1C2432"
                                BorderBrush="#2B3648" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="k" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Liste -->
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource Dugme}" Content="Ekle" Click="Ekle_Click"/>
                <Button Style="{StaticResource Dugme}" Content="Sil" Click="Sil_Click"/>
                <Button Style="{StaticResource Dugme}" Content="▲" Click="Yukari_Click" ToolTip="Yukarı taşı"/>
                <Button Style="{StaticResource Dugme}" Content="▼" Click="Asagi_Click" ToolTip="Aşağı taşı"/>
            </StackPanel>
            <ListBox x:Name="Liste" Background="#11151E" BorderBrush="#263041" Foreground="#E6EAF2"
                     SelectionChanged="Liste_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Ad}" Foreground="#E6EAF2" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Konum}" Foreground="#64748B" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Form" IsEnabled="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ad"/>
                        <TextBox x:Name="AdKutu"/>
                        <TextBlock Text="Konum / açıklama"/>
                        <TextBox x:Name="KonumKutu"/>
                        <TextBlock Text="Marka (adres ve PTZ düzenini belirler)"/>
                        <ComboBox x:Name="MarkaKutu" SelectionChanged="Marka_Degisti">
                            <ComboBoxItem Content="Hikvision"/>
                            <ComboBoxItem Content="Dahua"/>
                            <ComboBoxItem Content="Diğer (RTSP yolunu elle yaz)"/>
                        </ComboBox>
                        <TextBlock Text="Bağlantı"/>
                        <ComboBox x:Name="BaglantiKutu" SelectionChanged="Baglanti_Degisti">
                            <ComboBoxItem Content="Ağdan doğrudan (RTSP)"/>
                            <ComboBoxItem Content="Dahua P2P (uzak şantiye, seri no ile)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <StackPanel x:Name="RtspAlanlari">
                            <TextBlock Text="IP adresi / ana makine"/>
                            <TextBox x:Name="HostKutu"/>
                            <TextBlock Text="RTSP portu"/>
                            <TextBox x:Name="PortKutu" Text="554"/>
                        </StackPanel>
                        <StackPanel x:Name="P2pAlanlari" Visibility="Collapsed">
                            <TextBlock Text="Cihaz seri numarası"/>
                            <TextBox x:Name="SeriKutu"/>
                            <TextBlock Text="Dahua bulutuna dh-p2p.exe ile bağlanılır."
                                       Foreground="#64748B" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Kullanıcı adı" Margin="0,8,0,2"/>
                        <TextBox x:Name="KullaniciKutu"/>
                        <TextBlock Text="Parola"/>
                        <PasswordBox x:Name="ParolaKutu"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NVR kanalı (tek kamerada 1)"/>
                        <TextBox x:Name="KanalKutu" Text="1"/>
                        <CheckBox x:Name="AltAkisKutu" IsChecked="True"
                                  Content="Duvarda alt akış kullan (büyütünce ana akış)"/>
                        <CheckBox x:Name="PtzKutu" Content="PTZ (hareketli kamera)"/>
                        <CheckBox x:Name="AktifKutu" IsChecked="True" Content="Aktif"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Web / CGI portu (PTZ için)"/>
                        <TextBox x:Name="WebPortKutu" Text="80"/>
                        <TextBlock Text="Özel ana akış yolu (boş = markadan üretilir)"/>
                        <TextBox x:Name="AnaYolKutu"/>
                        <TextBlock Text="Özel alt akış yolu"/>
                        <TextBox x:Name="AltYolKutu"/>
                    </StackPanel>
                </Grid>

                <Border Background="#11151E" BorderBrush="#263041" BorderThickness="1"
                        CornerRadius="5" Padding="8" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock x:Name="AdresOnizleme" Text="" Foreground="#64748B"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SinaDugme" Style="{StaticResource Dugme}"
                                    Content="Bağlantıyı sına" Click="Sina_Click"/>
                            <TextBlock x:Name="SinamaSonucu" Text="" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Alt düğmeler -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="0,10,0,0"
                BorderBrush="#1E2430" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Dugme}" Content="Dışa aktar (XML)" Click="DisaAktar_Click"/>
                    <Button Style="{StaticResource Dugme}" Content="İçe aktar (XML)" Click="IceAktar_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Dugme}" Content="Vazgeç" Click="Vazgec_Click"/>
                    <Button Style="{StaticResource Dugme}" Content="Kaydet" Click="Kaydet_Click"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
